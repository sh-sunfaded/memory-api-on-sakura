# --- DB (PostgreSQL 接続文字列。同一ホストなら unix socket 経由でもよい) ---
DATABASE_URL=

# --- Embedding (OpenAI互換 /v1/embeddings。例: さくらのAI Engine) ---
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=

# --- cron / systemd timer 用シークレット (Authorization: Bearer) ---
CRON_SECRET=

# --- 書き口・読み口のbots ---
GITHUB_WEBHOOK_SECRET=
GITHUB_TOKEN=
SLACK_SIGNING_SECRET=
SLACK_BOT_TOKEN=

# --- 既定のスコープ(未指定時の退避先) ---
DEFAULT_SCOPE_TYPE=project
DEFAULT_SCOPE_ID=memory_api

# --- 統治パラメータ(類似0.85超は409差戻し・書込60/時) ---
SIM_THRESHOLD=0.85
RATE_LIMIT_PER_HOUR=60

# --- タイムアウト(任意。既定は埋め込み15秒・DB側tx 15秒) ---
# EMBEDDING_TIMEOUT_MS=15000
# DB_TIMEOUT_MS=15000

# --- 事前実測プローブ (src/eval/probe.ts。本番 EMBEDDING_* とは別変数) ---
PROBE_BASE_URL=
PROBE_API_KEY=
PROBE_MODEL=
